generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String    @default("user")
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String?
  bio       String?
  photos    String[]
  gender    String?
  birthDate String?
  location  String?
  interests String[]
  job       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String                  @id @default(uuid())
  code        String                  @unique
  name        String
  photo       String?
  description String?
  location    String?
  createdById String
  isActive    Boolean                 @default(true)
  isPublic    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  expiresAt    DateTime?
  maxAttendees Int?
  startsAt     DateTime?
  endedAt      DateTime?
  attendees    EventAttendee[]
  blockedUsers EventBlockedUser[]
  organizerMessages EventOrganizerMessage[]
  swipes      EventSwipe[]
  matches     EventMatch[]
  waitlist    EventWaitlist[]

  @@index([isPublic, isActive])
  @@index([createdById])
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  removedById String?
  removedAt   DateTime?

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, leftAt])
}

model EventWaitlist {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId])
}

model EventBlockedUser {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  blockedById String
  reason      String?
  blockedAt   DateTime @default(now())

  @@unique([eventId, userId])
}

model EventOrganizerMessage {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  readAt     DateTime?
}

model EventSwipe {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  swiperId  String
  swipedId  String
  direction String // like | pass | super
  createdAt DateTime @default(now())

  @@unique([eventId, swiperId, swipedId])
  @@index([eventId, swipedId, direction])
  @@index([swiperId])
}

model EventMatch {
  id        String          @id @default(uuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user1Id   String
  user2Id   String
  createdAt DateTime        @default(now())
  messages  EventMessage[]

  @@index([eventId, user1Id])
  @@index([eventId, user2Id])
}

model EventMessage {
  id        String     @id @default(uuid())
  matchId   String
  match     EventMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  createdAt DateTime   @default(now())
  readAt    DateTime?

  @@index([matchId, createdAt])
  @@index([senderId])
}

model Report {
  id         String   @id @default(uuid())
  eventId    String?
  reporterId String
  reportedId String
  reason     String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // like | match | message | organizer_message | request | request_accepted
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Todo {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
}

model EventMessageRequest {
  id         String   @id @default(uuid())
  eventId    String
  senderId   String
  receiverId String
  status     String   // pending | accepted | declined
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([eventId, senderId, receiverId])
}
